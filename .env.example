# =============================================================================
# SatQuery AI — environment configuration
# Copy to .env and fill in what you have. Nothing here is required to run the
# system in DEMO_MODE: every unset external dependency falls back to a mock
# implementation that is clearly labeled demo_mode=true in API responses.
# =============================================================================

# ---- Core mode -------------------------------------------------------------
DEMO_MODE=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------
# Local dev default: SQLite file, no server required.
# Production: postgresql+psycopg2://user:pass@host:5432/satquery  (with PostGIS)
DATABASE_URL=sqlite:///./satquery_dev.db

# ---- Redis (cache / Celery broker) ------------------------------------------
# If unset, task execution falls back to synchronous in-process mode.
REDIS_URL=

# ---- Task queue --------------------------------------------------------------
# inline = run analysis synchronously in-process (no Redis/Celery needed)
# celery = enqueue via Celery worker (requires REDIS_URL)
TASK_BACKEND=inline

# ---- Object storage (evidence images, masks, reports) -----------------------
# local = filesystem under ./data/local_storage (no server required)
# minio = S3-compatible object storage
STORAGE_BACKEND=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=satquery
REPORT_STORAGE_BUCKET=satquery-reports

# ---- Satellite data providers -----------------------------------------------
# Copernicus Data Space Ecosystem (Sentinel-1/2) — primary open provider
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ISRO / NRSC Bhoonidhi — reports "not configured" until credentials are set
BHOONIDHI_API_URL=
BHOONIDHI_API_KEY=

# USGS EarthExplorer / Landsat — fallback provider
USGS_API_KEY=

# Provider priority order, comma-separated
SATELLITE_PROVIDER_PRIORITY=copernicus,bhoonidhi,usgs

# ---- Agent (task planning LLM) ----------------------------------------------
# Family: Qwen3. Leave AGENT_MODEL_PATH unset to use the deterministic mock
# agent (rule/keyword-based en/hi/hinglish task-plan parser).
AGENT_MODEL_NAME=Qwen3-8B
AGENT_MODEL_PATH=

# ---- Model adapters -----------------------------------------------------
# Leave *_MODEL_PATH unset to use each adapter's mock implementation.
INTERNVL_MODEL_PATH=
PRITHVI_MODEL_PATH=
CHANGE_MODEL_PATH=
CROMA_MODEL_PATH=
SAR_MODEL_PATH=

# Advanced multimodal fallback — disabled by default (resource-heavy)
TERRAMIND_ENABLED=false
TERRAMIND_MODEL_PATH=

# ---- Compute ------------------------------------------------------------------
# auto | cpu | cuda | cuda:0
DEVICE=auto

# ---- Security -----------------------------------------------------------------
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=200

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
